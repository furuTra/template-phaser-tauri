{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sql-capability",
  "description": "SQL capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "log:default"
  ]
}