{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "window-capability",
  "description": "Window capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:window:allow-set-size",
    "core:window:allow-set-fullscreen",
    "core:window:allow-center"
  ]
}